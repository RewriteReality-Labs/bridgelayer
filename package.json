{
  "name": "bridgelayer",
  "version": "0.1.0",
  "description": "A seamless integration layer that bridges disparate systems and APIs",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src tests --ext .ts,.js",
    "lint:fix": "eslint src tests --ext .ts,.js --fix",
    "prepare": "npm run build"
  },
  "keywords": [
    "integration",
    "bridge",
    "api",
    "connector",
    "middleware",
    "sync"
  ],
  "author": "BridgeLayer Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/bridgelayer.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/bridgelayer/issues"
  },
  "homepage": "https://github.com/your-org/bridgelayer#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node"
  }
